#!/usr/bin/env bash
# ブラウザで JS を実際に動かす検査。1件でも失敗すれば NG・終了コード 1。
#   1. debug_test.php?run_tests=1 の JS テスト（bv / hg / bp の一覧）に失敗が無く、件数が 0 でない
#   2. debug_test.php と index.php でページのエラー（pageerror・console.error）が出ない
#   3. index.php で GenoData・CROSS_TABLE が読み込まれ、色名・繁殖計画の確率（連鎖の cis/trans を含む）が正本の表で計算できる。
#      登録画面で選んだ相が保存され、確率と編集画面に反映される（試験用の個体は最後に消す）
# Playwright（node から require('playwright')）と Chromium が要る。無い環境では SKIP して 0 を返す。
# BROWSER_TEST_REQUIRED=1（CI）のときは、無ければ NG にする。
root="$(cd "$(dirname "$0")/.." && pwd)"; cd "$root" || exit 1
required="${BROWSER_TEST_REQUIRED:-0}"
skip() { if [ "$required" = 1 ]; then echo "NG   browser-test: $1"; exit 1; fi; echo "SKIP browser-test: $1"; exit 0; }
command -v php >/dev/null 2>&1 || skip "php が無い"
command -v node >/dev/null 2>&1 || skip "node が無い"
node -e "require('playwright')" >/dev/null 2>&1 || skip "Playwright が無い（require('playwright') が解決できない）"
port="$(node -e "const s=require('net').createServer();s.listen(0,'127.0.0.1',()=>{console.log(s.address().port);s.close();})")"
log="$(mktemp)"
php -S "127.0.0.1:$port" -t "$root" >"$log" 2>&1 &
pid=$!
trap 'kill "$pid" 2>/dev/null; rm -f "$log"' EXIT
for _ in $(seq 1 50); do
  node -e "require('http').get('http://127.0.0.1:$port/genodata.js',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))" && break
  node -e "setTimeout(()=>{},100)"
done
BASE="http://127.0.0.1:$port" node - <<'JS'
const { chromium } = require('playwright');
const base = process.env.BASE, ng = [];
(async () => {
  let browser;
  try { browser = await chromium.launch(); }
  catch (e) { console.log('NG   browser-test: Chromium を起動できない: ' + e.message.split('\n')[0]); process.exit(1); }
  const open = async (path) => {
    const page = await browser.newPage(), errors = [];
    page.on('pageerror', e => errors.push('pageerror: ' + e.message));
    page.on('console', m => { if (m.type() === 'error') errors.push('console.error: ' + m.text()); });
    await page.goto(base + path, { waitUntil: 'load', timeout: 120000 });
    return { page, errors };
  };
  // 1・2. debug_test の JS テスト
  const t = await open('/debug_test.php?run_tests=1');
  await t.page.waitForFunction(() => ['bv-tests', 'hg-tests', 'bp-tests'].every(id => {
    const el = document.getElementById(id); return el && el.children.length > 0;
  }), null, { timeout: 60000 }).catch(() => ng.push('JS テストの一覧が埋まらない'));
  await t.page.waitForTimeout(1000);
  const js = await t.page.evaluate(() => ['bv-tests', 'hg-tests', 'bp-tests'].map(id => {
    const items = [...(document.getElementById(id) || { children: [] }).children];
    return { id, total: items.length,
             failed: items.filter(li => li.classList.contains('failed')).map(li => li.textContent.trim().replace(/\s+/g, ' ').slice(0, 160)) };
  }));
  let total = 0;
  for (const r of js) {
    total += r.total;
    if (r.total === 0) ng.push(`${r.id}: テストが 0 件`);
    for (const f of r.failed) ng.push(`${r.id}: ${f}`);
  }
  for (const e of t.errors) ng.push('debug_test.php ' + e);
  // 2・3. index.php
  const ix = await open('/index.php');
  await ix.page.waitForTimeout(1500);
  const app = await ix.page.evaluate(() => {
    const out = { GenoData: typeof GenoData, CROSS_TABLE: typeof CROSS_TABLE };
    if (typeof GenoData === 'undefined' || typeof BreedingPlanner === 'undefined' || typeof BirdDB === 'undefined') return out;
    const bird = (c, sex) => ({ sex, genotype: GenoData.colorGenotype(c, sex) });
    out.seagreen = BreedingPlanner.calculateTargetProbability(bird('turquoise', 'male'), bird('aqua', 'female'), BreedingPlanner.TARGET_REQUIREMENTS.seagreen);
    const z = (z1, z2) => ({ sex: 'male', genotype: { Z_linked: { Z1: z1, Z2: z2 } } });
    const wildF = { sex: 'female', genotype: {} }, oc = BreedingPlanner.TARGET_REQUIREMENTS.opaline_cinnamon_green;
    out.cis = BreedingPlanner.calculateTargetProbability(z({ cinnamon: 'cin', opaline: 'op' }, {}), wildF, oc);
    out.trans = BreedingPlanner.calculateTargetProbability(z({ cinnamon: 'cin' }, { opaline: 'op' }), wildF, oc);
    // 登録画面: 相の欄で cis を選んで保存 → 繁殖計画の確率と、編集時の欄の再現
    try {
      openBirdForm();
      document.getElementById('birdSex').value = 'male'; updateGenotypeOptions();
      const setv = (k, v) => { const el = document.getElementById('geno_' + k); el.value = v; el.dispatchEvent(new Event('change')); };
      setv('cin', GenoData.carrier('cinnamon', GenoData.colorGenotype('cinnamon_green', 'male').cinnamon));
      setv('op', GenoData.carrier('opaline', GenoData.colorGenotype('opaline_green', 'male').opaline));
      const sel = document.querySelector('#phaseFields select[data-group="Z_linked"]');
      const cisOpt = sel ? [...sel.options].find(o => o.value !== '' && o.textContent.trim().endsWith('/ +')) : null;
      if (cisOpt) sel.value = cisOpt.value;
      document.getElementById('birdName').value = '__browser_test_phase__';
      saveBird({ preventDefault() {} });
      const saved = BirdDB.getAllBirds().find(x => x.name === '__browser_test_phase__');
      out.formCis = saved ? BreedingPlanner.calculateTargetProbability(saved, wildF, oc) : null;
      if (saved) {
        openBirdForm(saved.id);
        const sel2 = document.querySelector('#phaseFields select[data-group="Z_linked"]');
        out.formEdit = sel2 && cisOpt ? sel2.value === cisOpt.value : false;
        closeBirdForm();
        BirdDB.deleteBird(saved.id);
      }
    } catch (e) { out.formError = e.message; }
    out.name = BirdDB.composeColorName({ parblue: 'aqaq', dark: 'Dd', pied_dom: 'Pi+', fallow_bronze: 'flbflb' }, 'en');
    return out;
  });
  if (app.GenoData !== 'object') ng.push('index.php: GenoData が無い');
  if (app.CROSS_TABLE !== 'object') ng.push('index.php: CROSS_TABLE が無い');
  if (app.seagreen === undefined || Math.abs(app.seagreen - 1) > 1e-9) ng.push(`index.php: turquoise × aqua → seagreen の確率が 1 でない（${app.seagreen}）`);
  if (!(Math.abs(app.cis - 0.172) < 1e-9 && Math.abs(app.trans - 0.078) < 1e-9)) ng.push(`index.php: 連鎖（cin–op）の cis/trans が PHP と違う（${app.cis} / ${app.trans}）`);
  if (app.formError) ng.push('index.php: 登録画面の相の入力でエラー: ' + app.formError);
  if (!(Math.abs(app.formCis - 0.172) < 1e-9)) ng.push(`index.php: 登録画面で cis を選んだ個体の確率が 17.2% でない（${app.formCis}）`);
  if (app.formEdit !== true) ng.push('index.php: 編集画面で保存した相が選ばれていない');
  if (app.name !== 'Bronze Fallow Dominant Pied Aqua Dark') ng.push(`index.php: 色名の組み立てが PHP と違う（${app.name}）`);
  for (const e of ix.errors) ng.push('index.php ' + e);
  await browser.close();
  if (ng.length) { console.log(ng.slice(0, 30).map(m => 'NG   browser-test: ' + m).join('\n')); console.log(`NG   browser-test: ${ng.length} 件`); process.exit(1); }
  console.log(`OK   browser-test: JS テスト ${total} 件すべて合格、debug_test.php・index.php にページのエラーなし`);
})().catch(e => { console.log('NG   browser-test: ' + e.message.split('\n')[0]); process.exit(1); });
JS
